{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "freetheai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeTheAI",
      "options": {
        "baseURL": "https://api.freetheai.xyz/v1",
        "apiKey": "{env:FREETHEAI_API_KEY}"
      },
      "models": {
        "glm/glm-5.2": { "name": "GLM-5.2 (1M) 🧠stratégie" },
        "olm/deepseek-v4-pro": { "name": "DeepSeek V4 Pro (1M) 💻code" },
        "kai/nvidia/nemotron-3-ultra-550b-a55b:free": { "name": "NVIDIA Ultra 550B (1M) ⚡agentic" },
        "min/minimax-m3": { "name": "MiniMax M3 (1M) 🖼️multimodal" },
        "opc/deepseek-v4-flash-free": { "name": "DeepSeek V4 Flash (200K) 🚀rapide" },
        "kai/cohere/north-mini-code:free": { "name": "Cohere North Mini (256K) ⚡code rapide" }
      }
    },
    "mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mistral AI",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiKey": "{env:MISTRAL_API_KEY}"
      },
      "models": {
        "mistral-large-latest": { "name": "Mistral Large (262K) 🏆généraliste" },
        "devstral-latest": { "name": "Devstral (262K) 🤖agentic" },
        "mistral-medium-latest": { "name": "Mistral Medium (262K) ⚖️équilibre" },
        "mistral-small-latest": { "name": "Mistral Small (262K) 💨léger" },
        "magistral-medium-latest": { "name": "Magistral Medium (131K) ⚡reasoning" },
        "ministral-8b-latest": { "name": "Ministral 8B (262K) 🚀fast" }
      }
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "openai/gpt-oss-120b": { "name": "GPT-OSS 120B (131K) 🚀vitesse" },
        "meta-llama/llama-4-scout-17b-16e-instruct": { "name": "Llama 4 Scout (131K) 👁️vision" },
        "llama-3.3-70b-versatile": { "name": "Llama 3.3 70B (131K) 🔒fiable" }
      }
    },
    "google": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Google Gemini",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "{env:GOOGLE_API_KEY}"
      },
      "models": {
        "models/gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro (1M) ⚡top code" },
        "models/gemini-2.5-pro": { "name": "Gemini 2.5 Pro (1M) 💰moins cher" },
        "models/gemini-2.5-flash": { "name": "Gemini 2.5 Flash (1M) 🧠contexte rapide" }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (free)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "qwen/qwen3-coder:free": { "name": "Qwen Coder (1M) 🧬code agentic" },
        "openai/gpt-oss-20b:free": { "name": "GPT-OSS 20B (131K) ⚡raisonnement" }
      }
    }
  },
  "model": "mistral/devstral-latest"
}
